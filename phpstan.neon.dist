parameters:
    level: 4
    paths:
        - src
        - config
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # Larastan cannot resolve the package's view namespace during analysis, so it cannot verify this view name.
        -
            identifier: property.defaultValue
            path: src/Widgets/TranslationStatusWidget.php
